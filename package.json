{
  "name": "cape-rip",
  "version": "0.1.0",
  "description": "Independent community hub for Cape Cellular: referral codes, speed tests, carrier comparisons, and service status.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lb-vn/caperip.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node build/index.js",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "format": "prettier --write '**/*.{ts,js,svelte,css,json,md}'",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.2.0",
    "@sveltejs/kit": "^2.8.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.31.10",
    "prettier": "^3.8.2",
    "prettier-plugin-svelte": "^3.5.1",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  },
  "dependencies": {
    "@lucide/svelte": "^1.11.0",
    "drizzle-orm": "^0.36.0",
    "naughty-words": "^1.2.0",
    "postgres": "^3.4.4"
  }
}
