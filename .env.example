# Postgres. `make dev` starts one in Docker on CAPE_DB_PORT.
DATABASE_URL=postgres://cape:cape@localhost:5432/cape
CAPE_DB_PORT=5432

# Required
IP_HASH_SECRET=
COOKIE_SECRET=

# Cloudflare Turnstile. Leave empty to skip captcha verification in dev.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Speed test worker (see worker/). The speed test panel is hidden when unset.
PUBLIC_SPEEDTEST_URL=

# Mapbox public (pk.) token for the coverage preview on the homepage.
# Optional - the preview is hidden when unset.
PUBLIC_MAPBOX_TOKEN=
